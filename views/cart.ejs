<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Shopping Cart</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-white text-gray-800 p-6">
     <nav class="fixed top-0 left-0 w-full bg-gray-800 py-4">
    <div class="container  mx-auto flex justify-between items-center">
      <div class="flex items-center">
        <a href="/showitem" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
          Home
        </a>
        <a href="/cart" class="bg-yellow-500 hover:bg-yellow-700 ml-2 text-white font-bold py-2 px-4 rounded">
                  Cart
                </a>
      </div>
      <div class="flex items-center">
        <span class="text-lg text-white font-bold mr-4"> Hi! <%= user.username %></span>
        <a href="/logout" class="bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-4 rounded">
          Logout
        </a>
      </div>
    </div>
  </nav>
  <div class="max-w-4xl mx-auto">
    <h1 class="text-3xl font-bold mb-8">Shopping Cart</h1>

    <!-- Cart Items -->
    <div class="space-y-6">
      <!-- Item -->
      <div class="flex justify-between items-center">
        <div class="flex items-center space-x-4">
          <img src="https://via.placeholder.com/60" alt="tee" class="w-16 h-16 rounded" />
          <div>
            <p class="font-medium">Men's Performance Running Tee</p>
            <p class="text-sm text-gray-500">Size: M</p>
          </div>
        </div>
        <div class="flex items-center space-x-2">
          <button class="w-8 h-8 flex items-center justify-center rounded-full bg-gray-100">−</button>
          <span>1</span>
          <button class="w-8 h-8 flex items-center justify-center rounded-full bg-gray-100">+</button>
        </div>
      </div>

      <!-- Item -->
      <div class="flex justify-between items-center">
        <div class="flex items-center space-x-4">
          <img src="https://via.placeholder.com/60" alt="shoes" class="w-16 h-16 rounded" />
          <div>
            <p class="font-medium">Women's Lightweight Running Shoes</p>
            <p class="text-sm text-gray-500">Size: 8</p>
          </div>
        </div>
        <div class="flex items-center space-x-2">
          <button class="w-8 h-8 flex items-center justify-center rounded-full bg-gray-100">−</button>
          <span>1</span>
          <button class="w-8 h-8 flex items-center justify-center rounded-full bg-gray-100">+</button>
        </div>
      </div>

      <!-- Item -->
      <div class="flex justify-between items-center">
        <div class="flex items-center space-x-4">
          <img src="https://via.placeholder.com/60" alt="shorts" class="w-16 h-16 rounded" />
          <div>
            <p class="font-medium">Unisex Training Shorts</p>
            <p class="text-sm text-gray-500">Size: L</p>
          </div>
        </div>
        <div class="flex items-center space-x-2">
          <button class="w-8 h-8 flex items-center justify-center rounded-full bg-gray-100">−</button>
          <span>1</span>
          <button class="w-8 h-8 flex items-center justify-center rounded-full bg-gray-100">+</button>
        </div>
      </div>
    </div>

    <!-- Order Summary -->
    <div class="mt-12 border-t pt-6">
      <h2 class="text-xl font-semibold mb-4">Order Summary</h2>
      <div class="space-y-2 text-gray-600">
        <div class="flex justify-between">
          <span>Subtotal</span>
          <span>$150.00</span>
        </div>
        <div class="flex justify-between">
          <span>Shipping</span>
          <span>$10.00</span>
        </div>
        <div class="flex justify-between">
          <span>Taxes</span>
          <span>$15.00</span>
        </div>
        <div class="flex justify-between font-bold text-black mt-4">
          <span>Total</span>
          <span>$175.00</span>
        </div>
      </div>

      <button class="mt-6 w-full md:w-auto bg-red-500 text-white px-6 py-2 rounded hover:bg-red-600 transition">
        Proceed to Checkout
      </button>
    </div>
  </div>
</body>
</html>
