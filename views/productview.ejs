<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>  
    <%= item.item %>
    </title>
    <link rel="stylesheet" href="/stylesheets/productview.css">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
        <nav class="fixed top-0 left-0 w-full bg-gray-800 py-4">
            <div class="container mx-auto flex justify-between items-center">
              <div class="flex items-center">
                <a href="/showitem" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
                  Home
                </a>
                <a href="/cart" class="bg-yellow-500 hover:bg-yellow-700 ml-2 text-white font-bold py-2 px-4 rounded">
                  Cart
                </a>
              </div>
              <div class="flex items-center">
                <span class="text-lg text-white font-bold mr-4"> <%= user.username %></span>
                <a href="/logout" class="bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-4 rounded">
                  Logout
                </a>
              </div>
            </div>
          </nav>
    <main>
        <div class="container mt-20">
            <!-- <div class="breadcrumb">
                <a href="#">Home</a> > <a href="#">Rings</a> > Love Knot Ring
            </div> -->
            <div class="product">
                <div class="product-image">
                    <img src= <%= item.img %> alt="Love Knot Ring">
                </div>
                <div class="product-info">
                    <h1><%= item.item %></h1>
                    <!-- <p>The Tiffany Knot collection features contemporary balancing of sophistication for the modern couple. This unique piece showcases a magnificent satin finish.</p> -->
                    <p class="price"> Rs. <%= item.price %></p>
                    <button class="add-to-cart">Add to Cart</button>
                    <div class="product-details">
                        <p><%= item.description %></p>
                        <!--<p>Categories: <a href="#">Diamond Rings</a></p>-->
                    </div>
                </div>
            </div>
        </div>
